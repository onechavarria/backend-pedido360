# Servidor y frontend permitido por CORS.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200
BACKEND_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pedidos360

# Usa una cadena aleatoria larga en producción.
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# OAuth: agrega solamente los proveedores que quieras activar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
