# Servidor y frontend permitido por CORS.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200
BACKEND_PUBLIC_URL=http://localhost:3000
# MySQL local o las credenciales entregadas por Hostinger.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=pedidos360
MYSQL_USER=pedidos360_user
MYSQL_PASSWORD=cambia-esta-contrasena
MYSQL_SSL=false

# Usa una cadena aleatoria larga en producción.
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# OAuth: deja vacías las credenciales de un proveedor si todavía no lo activarás.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
